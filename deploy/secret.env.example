# DatTTS — mẫu Modal secret `dattts` (SPEC Phần 4). KHÔNG chứa bí mật thật.
#
# Cách dùng:
#   cp deploy/secret.env.example ~/dattts-secret.env     # để NGOÀI repo (script từ chối file nằm trong repo)
#   chmod 600 ~/dattts-secret.env                        # script từ chối quyền rộng hơn 600
#   nano ~/dattts-secret.env                             # điền các giá trị <...>
#   scripts/deploy_modal.sh --env-file ~/dattts-secret.env [--first-run]
#
# Định dạng dotenv: KEY=value, mỗi biến một dòng, không có dấu cách quanh "=", ghi chú đặt ở dòng riêng.
# `modal secret create --force` GHI ĐÈ toàn bộ secret → file này phải luôn đầy đủ.

# ───────────── Proxy Cloudflare Pages (bắt buộc cho production) ─────────────
# Chuỗi ngẫu nhiên ≥ 32 ký tự, tạo bằng: openssl rand -hex 32
# Phải GIỐNG HỆT biến PROXY_SHARED_SECRET đặt trong Cloudflare Pages (scripts/deploy_pages.sh).
PROXY_SHARED_SECRET=<openssl rand -hex 32>
# 1 = chặn mọi /api/* gọi thẳng URL modal.run (403 direct_access_forbidden), trừ /api/health.
REQUIRE_PROXY=1
# Modal đứng sau proxy của chính nó → giữ 1 (dự phòng khi request không qua Pages).
TRUST_PROXY=1
# TRUST_PROXY_HOPS=1

# ───────────── Chung ─────────────
# Bearer cho /api/admin/* (trống = tắt trang admin). Tạo: openssl rand -hex 24
ADMIN_TOKEN=<openssl rand -hex 24>
# Key nội bộ không giới hạn, phân tách bằng dấu phẩy (có thể để trống)
API_KEYS=
# Gói Free: ký tự / ngày / IP (giờ VN)
FREE_DAILY_CHARS=20000
# Trần tổng ký tự miễn phí/ngày của cả hệ thống (0 = không giới hạn) và số lượt/phút/IP (0 = tắt)
FREE_GLOBAL_DAILY_CHARS=1000000
FREE_REQUESTS_PER_MIN=12
# Tự xoá file đã dựng sau N ngày (0 = giữ mãi; trang Bảo mật đang ghi 30 ngày)
FILE_RETENTION_DAYS=30
# Giới hạn độ dài văn bản
SYNC_MAX_CHARS=3000
JOB_MAX_CHARS=100000
# Tên miền chính (link trong email/checkout của Polar)
PUBLIC_BASE_URL=https://dattts.com
# Mặc định đã gồm dattts.com và www.dattts.com; chỉ cần đặt khi thêm tên miền khác.
# ALLOWED_ORIGINS=https://dattts.com,https://www.dattts.com
# JOB_STALE_SECONDS=900
# JOB_QUEUE_STALE_SECONDS=14400

# ───────────── Thanh toán Polar (để trống POLAR_ACCESS_TOKEN = tắt bán hàng, web hiện "Coming soon") ─────────────
POLAR_SERVER=production
# BÍ MẬT: polar_oat_… (Polar → Settings → Developers → Organization Access Token)
POLAR_ACCESS_TOKEN=<polar_oat_...>
# BÍ MẬT: whsec_… (webhook https://dattts.com/api/billing/webhook, định dạng Raw)
POLAR_WEBHOOK_SECRET=<whsec_...>
POLAR_ORGANIZATION_ID=cd16dd37-dd25-4e92-aaaa-23509784d129
# Chỉ dùng khi chạy Polar giả (scripts/fake_polar.py) — để trống trên production
# POLAR_API_BASE=

# Gói Pro: sản phẩm + benefit License Key (ID thật, công khai)
POLAR_PRODUCT_PRO_WEEK=3d54ccce-5b59-4903-a23b-18fd8c9e6fe1
POLAR_BENEFIT_PRO_WEEK=e02132d4-8b7c-4779-a271-cf778cada689
POLAR_PRODUCT_PRO_MONTH=5cdb0d3a-edf1-46aa-ba4f-b1e4303e60bf
POLAR_BENEFIT_PRO_MONTH=de10e5c4-5357-4ec8-81ca-5b2848226ac0
POLAR_PRODUCT_PRO_YEAR=673f4798-5c0b-4a6f-a6bc-002054bcd621
POLAR_BENEFIT_PRO_YEAR=170cee60-1cd2-428e-8e46-a50e753189fb

# Hạn mức (ký tự). Tuần = tuần ISO giờ VN; gói năm tính hạn mức theo THÁNG.
PLAN_PRO_WEEK_CHARS=250000
PLAN_PRO_MONTH_CHARS=1000000
PLAN_PRO_YEAR_MONTHLY_CHARS=1000000
