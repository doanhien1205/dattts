# DatTTS backend — ví dụ biến môi trường (KHÔNG chứa bí mật).
# Local:  cp .env.example .env  → điền giá trị → set -a; . ./.env; set +a; python server_local.py
# Modal:  các biến này đặt trong secret `dattts` (xem docstring modal_app.py / README).

# ── Chung ──
ADMIN_TOKEN=                     # Bearer cho /api/admin/* (trống = tắt trang admin)
API_KEYS=                        # key nội bộ không giới hạn, phân tách bằng dấu phẩy
FREE_DAILY_CHARS=20000           # gói Free: ký tự / ngày / IP (giờ VN)
# ALLOWED_ORIGINS=https://dattts.com,https://www.dattts.com,http://localhost:8000,http://127.0.0.1:8000
# TRUST_PROXY=0                  # Modal tự đặt 1
# DATTTS_MODEL_DIR=./models
# DATTTS_DATA_DIR=./.data

# ── Polar (Merchant of Record). Thiếu POLAR_ACCESS_TOKEN → billing tắt ("Coming soon"). ──
PUBLIC_BASE_URL=https://dattts.com         # local: http://127.0.0.1:8000 (success_url/return_url)
POLAR_SERVER=production                    # sandbox | production
# POLAR_API_BASE=                          # chỉ dùng khi chạy Polar giả (scripts/fake_polar.py)
POLAR_ACCESS_TOKEN=                        # BÍ MẬT: polar_oat_… (scope: checkouts:read checkouts:write products:read customer_sessions:write license_keys:read license_keys:write)
POLAR_WEBHOOK_SECRET=                      # BÍ MẬT: whsec_… (webhook https://dattts.com/api/billing/webhook, định dạng Raw)
POLAR_ORGANIZATION_ID=cd16dd37-dd25-4e92-aaaa-23509784d129

# Gói Pro (sản phẩm + benefit License Key, prefix DATTTS). Gói thiếu một trong hai ID → không bán gói đó.
POLAR_PRODUCT_PRO_WEEK=3d54ccce-5b59-4903-a23b-18fd8c9e6fe1
POLAR_BENEFIT_PRO_WEEK=e02132d4-8b7c-4779-a271-cf778cada689
POLAR_PRODUCT_PRO_MONTH=5cdb0d3a-edf1-46aa-ba4f-b1e4303e60bf
POLAR_BENEFIT_PRO_MONTH=de10e5c4-5357-4ec8-81ca-5b2848226ac0
POLAR_PRODUCT_PRO_YEAR=673f4798-5c0b-4a6f-a6bc-002054bcd621
POLAR_BENEFIT_PRO_YEAR=170cee60-1cd2-428e-8e46-a50e753189fb

# Hạn mức (ký tự). Tuần = tuần ISO giờ VN (reset thứ Hai 00:00 UTC+7); gói năm tính hạn mức theo THÁNG.
PLAN_PRO_WEEK_CHARS=250000
PLAN_PRO_MONTH_CHARS=1000000
PLAN_PRO_YEAR_MONTHLY_CHARS=1000000
